# ══════════════════════════════════════════════
#  Lead Generation Agents — Configuración
# ══════════════════════════════════════════════

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890

# ── Contactos GC ──────────────────────────────
CONTACTS_DIR=contacts
FUZZY_THRESHOLD=0.72

# ── Agentes — Activar/Desactivar ──────────────
# true = activo, false = desactivado
AGENT_PERMITS=true
AGENT_SOLAR=true
AGENT_RODENTS=true
AGENT_FLOOD=true
AGENT_CONSTRUCTION=true
AGENT_REALESTATE=true
AGENT_ENERGY=true
AGENT_PLACES=false
AGENT_YELP=false
AGENT_DECONSTRUCTION=true

# ── Intervalos de ejecución (minutos) ─────────
INTERVAL_PERMITS=60
INTERVAL_SOLAR=60
INTERVAL_RODENTS=120
INTERVAL_FLOOD=30
INTERVAL_CONSTRUCTION=60
INTERVAL_REALESTATE=120
INTERVAL_ENERGY=360
INTERVAL_PLACES=1440
INTERVAL_YELP=1440
INTERVAL_DECONSTRUCTION=120

# ══════════════════════════════════════════════
#  APIs Gratuitas (opcionales)
# ══════════════════════════════════════════════

# ── NREL Solar Resource API (gratuita) ────────
# Signup: https://developer.nrel.gov/signup/
NREL_API_KEY=

# ── US Census Bureau API (gratuita) ──────────
# Signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Socrata App Token (gratuita) ─────────────
# Signup en cada portal de datos abiertos
SOCRATA_APP_TOKEN=

# ══════════════════════════════════════════════
#  APIs de Pago (opcionales)
# ══════════════════════════════════════════════

# ── Google Places API ($200/mes créditos gratis) ─
# Console: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# ── Yelp Fusion API (5,000 calls/día gratis) ──
# Signup: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# ── Hunter.io — Email Finder (100/mes gratis) ─
# Signup: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# ── Apollo.io — Contact Enrichment (gratis) ───
# Signup: https://app.apollo.io/
APOLLO_API_KEY=

# ── SendGrid — Email Outreach ($15/mes) ───────
# Signup: https://signup.sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=leads@example.com
SENDGRID_TO_EMAIL=

# ── Twilio WhatsApp ($50/mes) ─────────────────
# Signup: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# ── Slack Webhook (gratis) ────────────────────
SLACK_WEBHOOK_URL=

# ══════════════════════════════════════════════
#  Configuración avanzada
# ══════════════════════════════════════════════

# Paralelismo (incrementado para 54 ciudades)
PARALLEL_CITIES=10
PARALLEL_SOLAR=10
PARALLEL_311=10
PARALLEL_REALESTATE=8
PARALLEL_ENERGY=6
PARALLEL_INSPECT=10

# ── Google Solar API ($0.40/request) ──────────
# Potencial solar a nivel edificio (panels, sqft, kWh)
# Console: https://console.cloud.google.com/ → Solar API
GOOGLE_SOLAR_API_KEY=

# ── Aurora Solar API ($100+/mes) ──────────────
# Pipeline de proyectos solares activos
AURORA_API_KEY=

# ── EnergySage API (partner) ─────────────────
# Marketplace: compradores activos buscando solar
ENERGYSAGE_API_KEY=

# ── ATTOM Property Data API ($200/mes) ───────
# Datos de propiedad: antigüedad, valor, propietario
# https://api.gateway.attomdata.com
ATTOM_API_KEY=

# ── Google Geocoding API ($5/1000 calls) ─────
# Geocodificación inversa para reportes de plagas
GOOGLE_GEOCODE_API_KEY=

# ── Thumbtack API (partner) ──────────────────
# Solicitudes activas de pest control
THUMBTACK_API_KEY=

# ── BuildZoom API (pago, $100-300/mes) ────────
# Tracking avanzado de proyectos de construcción
BUILDZOOM_API_KEY=

# ── Cross-Agent Deduplication ─────────────
DEDUP_WINDOW_DAYS=30

# ── Hot Zone Detection ───────────────────
HOT_ZONE_THRESHOLD=3
HOT_ZONE_RADIUS_M=500
HOT_ZONE_WINDOW_HRS=168

# ── Deconstruction ───────────────────────
DECON_MONTHS=3
PARALLEL_DECON=6

# Filtros
MIN_PERMIT_VALUE=50000
PERMIT_MONTHS=3
MIN_SALE_PRICE=400000
SALE_MONTHS=2
RODENT_MONTHS=2
CONSTRUCTION_MONTHS=1
ENERGY_MONTHS=6
SOURCE_TIMEOUT=45

# Base de datos
DB_PATH=data/leads.db

# Telegram rate limiting
TELEGRAM_MAX_MSG_MIN=20
TELEGRAM_MAX_BURST=10

# ══════════════════════════════════════════════
#  Krayin CRM
# ══════════════════════════════════════════════

# URL base del CRM (sin / al final)
KRAYIN_URL=http://localhost

# Credenciales admin de Krayin (para API sync)
KRAYIN_ADMIN_EMAIL=admin@example.com
KRAYIN_ADMIN_PASSWORD=admin123

# Password de MySQL para Krayin (auto-generado por deploy.sh)
KRAYIN_DB_PASSWORD=

# Leads por ciclo de sync (cada 5 min)
CRM_SYNC_BATCH=50

# ══════════════════════════════════════════════
#  LLM layer (outreach/llm/)
# ══════════════════════════════════════════════
# Adapter backend — "anthropic" (default), "suna" (see
# docs/SUNA_INTEGRATION.md) or "noop" (forced fallback).
LLM_ADAPTER=anthropic

# Anthropic API — required when LLM_ADAPTER=anthropic. If unset, the
# daemon auto-switches to NoopAdapter and keeps running with the legacy
# template + heuristic qualifier.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-6
# Defaults to LLM_MODEL. Set to claude-haiku-4-5 if you want to downgrade
# the high-volume enrichment path to save cost.
LLM_ENRICH_MODEL=
LLM_MAX_TOKENS=1024

# Suna sidecar (only used when LLM_ADAPTER=suna). See docs/SUNA_INTEGRATION.md.
SUNA_BASE_URL=

# LlamaIndex RAG for the outreach writer. Drop PG&E / Title 24 /
# ENERGY STAR PDFs into LLM_RAG_DOCS_DIR then run:
#   python manage.py build_rag_index
# The writer injects the top-4 matches as "References" and is told
# to cite one if it fits.
LLM_RAG_ENABLED=true
LLM_RAG_DOCS_DIR=data/rag_docs
LLM_RAG_INDEX_PATH=data/rag_index

# Daemon task intervals for the LLM layer
ENRICH_INTERVAL_MIN=30
