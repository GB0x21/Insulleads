# ══════════════════════════════════════════════
#  Lead Generation Agents — Configuración
# ══════════════════════════════════════════════

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890

# Rate limiting: Telegram soporta ~30 msg/s, pero usamos límite conservador.
# Aumentar si necesitas más throughput, o usar multi-canal (email/WhatsApp).
TELEGRAM_MAX_MSG_MIN=100
TELEGRAM_MAX_BURST=20

# ── Contactos GC ──────────────────────────────
CONTACTS_DIR=contacts
FUZZY_THRESHOLD=0.72

# ── Agentes — Activar/Desactivar ──────────────
# true = activo, false = desactivado
AGENT_PERMITS=true
AGENT_SOLAR=true
AGENT_RODENTS=true
AGENT_FLOOD=true
AGENT_CONSTRUCTION=true
AGENT_REALESTATE=true
AGENT_ENERGY=true
AGENT_PLACES=false
AGENT_YELP=false
AGENT_DECONSTRUCTION=true

# Opt-in agents (free, no API key needed — flip to true to enable)
# Cal Fire DINS post-wildfire rebuilds
AGENT_DINS=false
# HUD/LIHTC multifamily rehab leads
AGENT_HUD_MULTIFAMILY=false

# Opt-in agents (require API key)
# Shovels.ai national permit aggregator
AGENT_SHOVELS=false

# ── Intervalos de ejecución (minutos) ─────────
INTERVAL_PERMITS=60
INTERVAL_SOLAR=60
INTERVAL_RODENTS=120
INTERVAL_FLOOD=30
INTERVAL_CONSTRUCTION=60
INTERVAL_REALESTATE=120
INTERVAL_ENERGY=360
INTERVAL_PLACES=1440
INTERVAL_YELP=1440
INTERVAL_DECONSTRUCTION=120
INTERVAL_DINS=1440
INTERVAL_HUD_MULTIFAMILY=1440
INTERVAL_SHOVELS=1440

# ══════════════════════════════════════════════
#  Cal Fire DINS — post-wildfire rebuilds (free)
# ══════════════════════════════════════════════
# Activate with: echo "AGENT_DINS=true" >> .env
# Data: Cal Fire DINS ArcGIS FeatureServer — no key required.
# DINS_LAYERS: comma-separated ArcGIS query URLs (defaults to 2023-2025).
# DINS_DAMAGE_MIN options: destroyed | major | minor | affected
DINS_DAMAGE_MIN=major
DINS_MAX_RECORDS=1000
DINS_TIMEOUT_S=45
# Leave DINS_LAYERS empty to use the built-in defaults (2023-2025)
DINS_LAYERS=

# ══════════════════════════════════════════════
#  HUD Multifamily / LIHTC (free)
# ══════════════════════════════════════════════
# Activate with: echo "AGENT_HUD_MULTIFAMILY=true" >> .env
# Data: HUD ArcGIS FeatureServer — no key required.
HUD_STATE=CA
HUD_MIN_UNITS=8
HUD_REHAB_WINDOW_YRS=20
HUD_MAX_RECORDS=2000
HUD_TIMEOUT_S=60
# Override ArcGIS URLs only if HUD publishes a new layer version:
HUD_LIHTC_URL=
HUD_MULTIFAMILY_URL=

# ══════════════════════════════════════════════
#  Shovels.ai — national permit aggregator
# ══════════════════════════════════════════════
# Signup (free tier): https://shovels.ai/
# Activate with:
#   echo "SHOVELS_API_KEY=your_key" >> .env
#   echo "AGENT_SHOVELS=true" >> .env
SHOVELS_API_KEY=
SHOVELS_STATES=CA
SHOVELS_PERMIT_TYPES=RESIDENTIAL,ADDITION,NEW_CONSTRUCTION,REROOF,REMODEL
SHOVELS_MIN_VALUE=50000
SHOVELS_DAYS_BACK=90
SHOVELS_MAX_PER_STATE=200
SHOVELS_TIMEOUT_S=45

# ══════════════════════════════════════════════
#  APIs Gratuitas (opcionales)
# ══════════════════════════════════════════════

# ── NREL Solar Resource API (gratuita) ────────
# Signup: https://developer.nrel.gov/signup/
NREL_API_KEY=

# ── US Census Bureau API (gratuita) ──────────
# Signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Socrata App Token (gratuita) ─────────────
# Signup en cada portal de datos abiertos
SOCRATA_APP_TOKEN=

# ══════════════════════════════════════════════
#  APIs de Pago (opcionales)
# ══════════════════════════════════════════════

# ── Google Places API ($200/mes créditos gratis) ─
# Console: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# ── Yelp Fusion API (5,000 calls/día gratis) ──
# Signup: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# ── Hunter.io — Email Finder (100/mes gratis) ─
# Signup: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# ── Apollo.io — Contact Enrichment (gratis) ───
# Signup: https://app.apollo.io/
APOLLO_API_KEY=

# ── SendGrid — Email Outreach ($15/mes) ───────
# Signup: https://signup.sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=leads@example.com
SENDGRID_TO_EMAIL=

# ── Twilio WhatsApp ($50/mes) ─────────────────
# Signup: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# ── Slack Webhook (gratis) ────────────────────
SLACK_WEBHOOK_URL=

# ══════════════════════════════════════════════
#  Configuración avanzada
# ══════════════════════════════════════════════

# Paralelismo (incrementado para 54 ciudades)
PARALLEL_CITIES=10
PARALLEL_SOLAR=10
PARALLEL_311=10
PARALLEL_REALESTATE=8
PARALLEL_ENERGY=6
PARALLEL_INSPECT=10

# ── Google Solar API ($0.40/request) ──────────
# Potencial solar a nivel edificio (panels, sqft, kWh)
# Console: https://console.cloud.google.com/ → Solar API
GOOGLE_SOLAR_API_KEY=

# ── Aurora Solar API ($100+/mes) ──────────────
# Pipeline de proyectos solares activos
AURORA_API_KEY=

# ── EnergySage API (partner) ─────────────────
# Marketplace: compradores activos buscando solar
ENERGYSAGE_API_KEY=

# ── ATTOM Property Data API ($200/mes) ───────
# Datos de propiedad: antigüedad, valor, propietario
# https://api.gateway.attomdata.com
ATTOM_API_KEY=

# ── Google Geocoding API ($5/1000 calls) ─────
# Geocodificación inversa para reportes de plagas
GOOGLE_GEOCODE_API_KEY=

# ── Thumbtack API (partner) ──────────────────
# Solicitudes activas de pest control
THUMBTACK_API_KEY=

# ── BuildZoom API (pago, $100-300/mes) ────────
# Tracking avanzado de proyectos de construcción
BUILDZOOM_API_KEY=

# ── Cross-Agent Deduplication ─────────────
DEDUP_WINDOW_DAYS=30

# ── Hot Zone Detection ───────────────────
HOT_ZONE_THRESHOLD=3
HOT_ZONE_RADIUS_M=500
HOT_ZONE_WINDOW_HRS=168

# ── Deconstruction ───────────────────────
DECON_MONTHS=3
PARALLEL_DECON=6

# Filtros
MIN_PERMIT_VALUE=50000
PERMIT_MONTHS=3
MIN_SALE_PRICE=400000
SALE_MONTHS=2
RODENT_MONTHS=2
CONSTRUCTION_MONTHS=1
ENERGY_MONTHS=6
SOURCE_TIMEOUT=45

# Base de datos
DB_PATH=data/leads.db

# Telegram rate limiting
TELEGRAM_MAX_MSG_MIN=20
TELEGRAM_MAX_BURST=10

# ══════════════════════════════════════════════
#  Memory Engine — claude-mem inspired (Fase 2)
# ══════════════════════════════════════════════

# Memoria persistente por agente (SQLite FTS5 + hash embeddings)
# Observaciones máximas a retener por agente
MEMORY_WINDOW=200
# Observaciones antes de generar resumen comprimido
MEMORY_COMPRESS_TRIGGER=50

# Historial de conversiones (feedback loop del CRM)
# Outcomes mínimos para activar ajuste de score
MIN_OUTCOMES_FOR_SIGNAL=5
# Similitud coseno mínima para considerar leads similares (0.0-1.0)
OUTCOME_SIMILARITY_THRESHOLD=0.6

# Bonus/penalty máximo de la memoria al score del lead (0-100)
# +N pts si el contratista tiene WON previos
MAX_MEMORY_BONUS=15
# -N pts si leads similares históricamente resultaron LOST
MAX_MEMORY_PENALTY=10

# ══════════════════════════════════════════════
#  Hermes-style Scheduler (Fase 1)
# ══════════════════════════════════════════════

# Health report — resumen del estado de agentes enviado a Telegram
# Cada cuántos minutos enviar health report a Telegram
HEALTH_INTERVAL_MIN=120

# Circuit Breaker — pausa agentes que fallan repetidamente
# Fallos consecutivos antes de abrir el circuit breaker
CB_THRESHOLD=3
# Minutos de pausa base (se duplica por cada fallo extra)
CB_BACKOFF_BASE_MIN=15
# Máximo de pausa en minutos (4 horas)
CB_BACKOFF_MAX_MIN=240

# Adaptive Intervals — ajusta frecuencia según productividad del agente
# Últimas N ejecuciones para calcular productividad
ADAPTIVE_WINDOW=10
# Promedio de leads >= este valor -> intervalo -30%
PRODUCTIVE_THRESHOLD=2.0
# Promedio de leads < este valor -> intervalo +50%
QUIET_THRESHOLD=0.5

# ══════════════════════════════════════════════
#  MarkItDown — document conversion (Fase 3)
# ══════════════════════════════════════════════
# Documentos PDF/Word/Excel/imágenes → Markdown estructurado
# Instalar: pip install markitdown
# Más eficiente que firecrawl para documentos estáticos (permisos, inspecciones)

# Timeout en segundos para descargar documentos desde URLs
MARKITDOWN_TIMEOUT_S=30
# Límite de tamaño para documentos (en MB)
MARKITDOWN_MAX_SIZE_MB=100

# ══════════════════════════════════════════════
#  Firecrawl — web scraping engine (Fase 3)
# ══════════════════════════════════════════════
# Signup: https://firecrawl.dev  |  pip install firecrawl-py
# Permite scrapear portales sin API Socrata/CKAN y enriquecer leads con
# datos de webs de contratistas, noticias locales, etc.

# API key de firecrawl.dev (o dejar vacío si self-hosted)
FIRECRAWL_API_KEY=fc-...
# Timeout en segundos por request
FIRECRAWL_TIMEOUT_S=30

# ══════════════════════════════════════════════
#  Playwright — browser automation (Fase 3)
# ══════════════════════════════════════════════
# Instalar: pip install playwright && playwright install chromium
# Para portales JS-rendered, paginación interactiva o formularios.

# Timeout en ms para operaciones de browser
PLAYWRIGHT_TIMEOUT_MS=30000
# false para depuración (muestra el browser)
PLAYWRIGHT_HEADLESS=true

# ══════════════════════════════════════════════
#  Krayin CRM
# ══════════════════════════════════════════════

# URL base del CRM (sin / al final)
KRAYIN_URL=http://localhost

# Credenciales admin de Krayin (para API sync)
KRAYIN_ADMIN_EMAIL=admin@example.com
KRAYIN_ADMIN_PASSWORD=admin123

# Password de MySQL para Krayin (auto-generado por deploy.sh)
KRAYIN_DB_PASSWORD=

# Leads por ciclo de sync (cada 5 min)
CRM_SYNC_BATCH=50

# ══════════════════════════════════════════════
#  LLM layer (outreach/llm/)
# ══════════════════════════════════════════════
# Adapter backend — "anthropic" (default), "suna" (see
# docs/SUNA_INTEGRATION.md) or "noop" (forced fallback).
LLM_ADAPTER=anthropic

# Anthropic API — required when LLM_ADAPTER=anthropic. If unset, the
# daemon auto-switches to NoopAdapter and keeps running with the legacy
# template + heuristic qualifier.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-6
# Defaults to LLM_MODEL. Set to claude-haiku-4-5 if you want to downgrade
# the high-volume enrichment path to save cost.
LLM_ENRICH_MODEL=
LLM_MAX_TOKENS=1024

# Suna sidecar (only used when LLM_ADAPTER=suna). See docs/SUNA_INTEGRATION.md.
SUNA_BASE_URL=

# LlamaIndex RAG for the outreach writer. Drop PG&E / Title 24 /
# ENERGY STAR PDFs into LLM_RAG_DOCS_DIR then run:
#   python manage.py build_rag_index
# The writer injects the top-4 matches as "References" and is told
# to cite one if it fits.
LLM_RAG_ENABLED=true
LLM_RAG_DOCS_DIR=data/rag_docs
LLM_RAG_INDEX_PATH=data/rag_index

# ══════════════════════════════════════════════
# Contract discovery + analysis (outreach/llm/contract_*)
# ══════════════════════════════════════════════
# Multi-agent pipeline that (a) discovers open bids/RFPs on SAM.gov and
# via Claude web_search, creating Lead+Contract rows, then (b) analyzes
# each Contract with an orchestrator + sub-agents (pricing, liability,
# termination, SLA, IP, governing law) and writes scorecard / redlines /
# recommendation back to the row.
CONTRACT_DISCOVERY_ENABLED=true
CONTRACT_ANALYSIS_ENABLED=true
CONTRACT_DOCS_DIR=data/contracts
CONTRACT_MAX_FILE_SIZE_MB=50
# How often the daemon re-fetches each contract-discovery source.
CONTRACT_DISCOVERY_INTERVAL_MIN=360

# SAM.gov (U.S. federal procurement) — API key is free:
#   https://open.gsa.gov/api/get-opportunities-public-api/
SAM_GOV_API_KEY=
# NAICS codes to filter by (238310 = insulation contractors).
SAM_GOV_NAICS_CODES=238310,238990

# Claude web_search as a generic bid discovery source (needs ANTHROPIC_API_KEY).
WEB_SEARCH_DISCOVERY_ENABLED=true

# Analyzer models. Orchestrator + synthesizer use Opus for reasoning,
# sub-agents use Haiku for parallel per-category extraction.
CONTRACT_ORCHESTRATOR_MODEL=claude-opus-4-6
CONTRACT_SUBAGENT_MODEL=claude-haiku-4-5
CONTRACT_SYNTHESIZER_MODEL=claude-opus-4-6
CONTRACT_SUBAGENT_PARALLELISM=4
CONTRACT_MAX_INPUT_CHARS=600000
CONTRACT_CATEGORIES=pricing,liability,termination,sla_performance,ip_confidentiality,governing_law

# ══════════════════════════════════════════════
# Thermal engine (outreach/thermal/)
# ══════════════════════════════════════════════
# Path to a GCP service-account JSON with Earth Engine access. Only
# needed by `python manage.py thermal_pull`; the daemon reads the
# cached parquet and does not need credentials at runtime. See
# docs/THERMAL_SETUP.md for the GCP + Earth Engine bring-up.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional default bbox (min_lon,min_lat,max_lon,max_lat) — used by
# agents/scripts when no --city / --bbox is passed.
THERMAL_BBOX=-122.52,37.70,-122.35,37.83
# Minimum Kelvin delta above the scene median before a building is
# flagged as a thermal anomaly and emitted as a lead.
THERMAL_MIN_ANOMALY_K=3.0

# Daemon task intervals for the LLM layer
ENRICH_INTERVAL_MIN=30

# ══════════════════════════════════════════════
#  Email Prospect Agent
# ══════════════════════════════════════════════
# How often the daemon runs the email prospect outreach task (minutes).
EMAIL_PROSPECT_INTERVAL_MIN=30
# Maximum personalized prospect emails sent per day (across all leads).
# Keep low to stay within SendGrid free tier (100/day) and avoid spam flags.
MAX_EMAIL_PROSPECT_PER_DAY=50
# Delay between Hunter.io API calls (seconds) — free tier: ~1 req/s.
HUNTER_DELAY_S=1.2
# Delay between Apollo.io API calls (seconds).
APOLLO_DELAY_S=0.5

# ══════════════════════════════════════════════
#  Scrapy crawling layer (scrapy_crawlers/)
# ══════════════════════════════════════════════
# Only used when a Source has kind="scrapy". The daemon runs
# `scrapy crawl <spider>` as a subprocess and reads JSONL output.
# See docs/SCRAPY_INTEGRATION.md for how to wire a spider to a Source.
SCRAPY_LOG_LEVEL=INFO
SCRAPY_USER_AGENT=Insulleads-Crawler/1.0 (+https://github.com/gb0x21/insulleads)
# Subprocess timeout per spider run (seconds).
SCRAPY_TIMEOUT=300
# Enable the on-disk HTTP cache (polite crawling during development).
SCRAPY_HTTPCACHE=1
