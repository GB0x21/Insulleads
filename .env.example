# ══════════════════════════════════════════════
#  Insul-Techs Lead Agents — Configuración
# ══════════════════════════════════════════════

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890

# ── Contactos GC ──────────────────────────────
CONTACTS_DIR=contacts
FUZZY_THRESHOLD=0.72

# ── Agentes — Activar/Desactivar ──────────────
# true = activo, false = desactivado
AGENT_PERMITS=true
AGENT_SOLAR=true
AGENT_RODENTS=true
AGENT_FLOOD=true
AGENT_CONSTRUCTION=true
AGENT_REALESTATE=true
AGENT_ENERGY=true
AGENT_PLACES=false
AGENT_YELP=false

# ── Intervalos de ejecución (minutos) ─────────
INTERVAL_PERMITS=60
INTERVAL_SOLAR=60
INTERVAL_RODENTS=120
INTERVAL_FLOOD=30
INTERVAL_CONSTRUCTION=60
INTERVAL_REALESTATE=120
INTERVAL_ENERGY=360
INTERVAL_PLACES=1440
INTERVAL_YELP=1440

# ══════════════════════════════════════════════
#  APIs Gratuitas (opcionales)
# ══════════════════════════════════════════════

# ── NREL Solar Resource API (gratuita) ────────
# Signup: https://developer.nrel.gov/signup/
NREL_API_KEY=

# ── US Census Bureau API (gratuita) ──────────
# Signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Socrata App Token (gratuita) ─────────────
# Signup en cada portal de datos abiertos
SOCRATA_APP_TOKEN=

# ══════════════════════════════════════════════
#  APIs de Pago (opcionales)
# ══════════════════════════════════════════════

# ── Google Places API ($200/mes créditos gratis) ─
# Console: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# ── Yelp Fusion API (5,000 calls/día gratis) ──
# Signup: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# ── Hunter.io — Email Finder (100/mes gratis) ─
# Signup: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# ── Apollo.io — Contact Enrichment (gratis) ───
# Signup: https://app.apollo.io/
APOLLO_API_KEY=

# ── SendGrid — Email Outreach ($15/mes) ───────
# Signup: https://signup.sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=leads@insul-techs.com
SENDGRID_TO_EMAIL=

# ── Twilio WhatsApp ($50/mes) ─────────────────
# Signup: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# ── Slack Webhook (gratis) ────────────────────
SLACK_WEBHOOK_URL=

# ══════════════════════════════════════════════
#  Configuración avanzada
# ══════════════════════════════════════════════

# Paralelismo
PARALLEL_CITIES=6
PARALLEL_SOLAR=6
PARALLEL_311=5
PARALLEL_REALESTATE=4
PARALLEL_ENERGY=4
PARALLEL_INSPECT=6

# ── Google Solar API ($0.40/request) ──────────
# Potencial solar a nivel edificio (panels, sqft, kWh)
# Console: https://console.cloud.google.com/ → Solar API
GOOGLE_SOLAR_API_KEY=

# ── Aurora Solar API ($100+/mes) ──────────────
# Pipeline de proyectos solares activos
AURORA_API_KEY=

# ── EnergySage API (partner) ─────────────────
# Marketplace: compradores activos buscando solar
ENERGYSAGE_API_KEY=

# ── ATTOM Property Data API ($200/mes) ───────
# Datos de propiedad: antigüedad, valor, propietario
# https://api.gateway.attomdata.com
ATTOM_API_KEY=

# ── Google Geocoding API ($5/1000 calls) ─────
# Geocodificación inversa para reportes de plagas
GOOGLE_GEOCODE_API_KEY=

# ── Thumbtack API (partner) ──────────────────
# Solicitudes activas de pest control
THUMBTACK_API_KEY=

# ── BuildZoom API (pago, $100-300/mes) ────────
# Tracking avanzado de proyectos de construcción
BUILDZOOM_API_KEY=

# Filtros
MIN_PERMIT_VALUE=50000
PERMIT_MONTHS=3
MIN_SALE_PRICE=400000
SALE_MONTHS=2
RODENT_MONTHS=2
CONSTRUCTION_MONTHS=1
ENERGY_MONTHS=6
SOURCE_TIMEOUT=45

# Base de datos
DB_PATH=data/leads.db

# Telegram rate limiting
TELEGRAM_MAX_MSG_MIN=20
TELEGRAM_MAX_BURST=10
